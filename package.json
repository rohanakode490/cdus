{
  "name": "tauri-app",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "check:targets:setup": "rustup target add x86_64-pc-windows-gnu x86_64-apple-darwin",
    "check:windows": "cargo check --workspace --exclude tauri-app --target x86_64-pc-windows-gnu",
    "check:macos": "cargo check --workspace --exclude tauri-app --target x86_64-apple-darwin",
    "check:protocols": "cargo check -p cdus-common --target x86_64-pc-windows-gnu && cargo check -p cdus-common --target x86_64-apple-darwin",
    "check:all-targets": "cargo check --workspace --exclude tauri-app && bun run check:protocols",
    "test:frontend": "bun test tests/frontend",
    "test:e2e": "bun run tests/e2e/desktop.spec.ts",
    "web:dev": "cd web && bun run dev",
    "web:build": "cd web && bun run build",
    "web:check": "cd web && bun run check",
    "web:lint": "cd web && bun run lint"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "html5-qrcode": "^2.3.8",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.4.2",
    "@types/qrcode": "^1.5.6",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
