---
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand-link" aria-label="CDUS Home">
      <img src="/cdus-logo.svg" alt="" width="34" height="34" class="brand-icon" />
      <span class="brand-name">CDUS</span>
      <span class="brand-badge">v0.1 Beta</span>
    </a>

    <nav class="nav-menu" aria-label="Primary Navigation">
      <a href={isHome ? "#how-it-works" : "/#how-it-works"} class="nav-link">How It Works</a>
      <a href={isHome ? "#comparison" : "/#comparison"} class="nav-link">Comparison</a>
      <a href="/security" class={`nav-link ${pathname === '/security' ? 'active' : ''}`}>Security</a>
      <a href="/docs/getting-started" class={`nav-link ${pathname.startsWith('/docs') ? 'active' : ''}`}>Docs</a>
      <a href="/privacy" class={`nav-link ${pathname === '/privacy' ? 'active' : ''}`}>Privacy</a>
    </nav>

    <div class="header-actions">
      <a href="https://github.com/rohanakode490/cdus" target="_blank" rel="noopener noreferrer" class="btn btn-ghost github-link" aria-label="GitHub Repository">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
      <a href="/download" class="btn btn-primary btn-sm download-cta">
        Download
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(26, 26, 26, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--cdus-dark-border);
    height: var(--header-height);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    color: var(--cdus-text-primary);
  }

  .brand-name {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--cdus-text-primary);
  }

  .brand-badge {
    font-size: 0.68rem;
    padding: 0.15rem 0.45rem;
    background: var(--cdus-cyan-container);
    color: var(--cdus-cyan-light);
    border: 1px solid rgba(36, 200, 219, 0.25);
    border-radius: var(--radius-sm);
    font-weight: 600;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .nav-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--cdus-text-secondary);
    padding: 0.35rem 0;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--cdus-cyan);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .download-cta {
    padding: 0.5rem 1.1rem;
    font-size: 0.875rem;
  }

  @media (max-width: 768px) {
    .nav-menu {
      display: none;
    }
  }
</style>
